# ---------------------------------------------------------------------------
# AI Agents Master — Environment configuration
# Copy to .env and fill in values. Never commit .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# App
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database — two modes (resolver: SUPABASE wins if set, else LOCAL)
# ---------------------------------------------------------------------------
# A) Local Postgres (e.g. Docker Compose) — async URL for the app
LOCAL_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agents

# B) Supabase Postgres (remote) — uncomment and set to use Supabase; app enables SSL automatically
# Use async driver postgresql+asyncpg (not postgresql). URL-encode password if it has # $ ! etc.
# Option 1 — Direct (port 5432): postgresql+asyncpg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Option 2 — Pooler (port 6543): postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Resolved DATABASE_URL = SUPABASE_DB_URL if set, else LOCAL_DB_URL (no need to set DATABASE_URL)

# ---------------------------------------------------------------------------
# Alembic migrations — sync URLs (postgresql://, not asyncpg)
# Same resolver: ALEMBIC_SUPABASE_DB_URL if set, else ALEMBIC_LOCAL_DB_URL.
# ---------------------------------------------------------------------------
ALEMBIC_LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/ai_agents
ALEMBIC_SUPABASE_DB_URL=postgresql://postgres:j2emcC%245%21Ly9uL4@db.omcossrlihrqemtkxlbi.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql+asyncpg://postgres:j2emcC%245%21Ly9uL4@db.omcossrlihrqemtkxlbi.supabase.co:5432/postgres

# Optional: Supabase API (Auth, Storage, etc.)
SUPABASE_URL=https://omcossrlihrqemtkxlbi.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI / ChatGPT — get key from https://platform.openai.com/api-keys (never commit .env)
# OPENAI_API_KEY=sk-proj-...
