# ---------------------------------------------------------------------------
# AI Agents Master — Environment configuration
# Copy to .env and fill in values. Never commit .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# App
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database — two modes (resolver: SUPABASE wins if set, else LOCAL)
# ---------------------------------------------------------------------------
# A) Local Postgres (e.g. Docker Compose) — async URL for the app
LOCAL_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agents

# B) Supabase Postgres (remote) — set this to use Supabase; app then uses it and enables SSL
# Get from: Supabase Dashboard → Project → Settings → Database → Connection string (URI, Transaction)
# Use "Transaction" mode and replace [YOUR-PASSWORD] with your database password.
# SUPABASE_DB_URL=postgresql+asyncpg://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=

# Resolved DATABASE_URL = SUPABASE_DB_URL if set, else LOCAL_DB_URL (no need to set DATABASE_URL)

# ---------------------------------------------------------------------------
# Alembic migrations — sync URLs (postgresql://, not asyncpg)
# Same resolver: ALEMBIC_SUPABASE_DB_URL if set, else ALEMBIC_LOCAL_DB_URL.
# ---------------------------------------------------------------------------
ALEMBIC_LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/ai_agents

postgresql://postgres:j2emcC$5!Ly9uL4@db.omcossrlihrqemtkxlbi.supabase.co:5432/postgres
# ALEMBIC_SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# ALEMBIC_SUPABASE_DB_URL=

# Optional: Supabase API (Auth, Storage, etc.)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
